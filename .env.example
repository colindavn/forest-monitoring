# Google Earth Engine Cloud project id (non-commercial registration)
GEE_PROJECT=
# Optional: path to a service account JSON key (CI only)
GEE_SERVICE_ACCOUNT_JSON=
# Global Forest Watch Data API key (header x-api-key)
GFW_API_KEY=
# Default forest threshold (% tree cover 2000); v1 computes 10, 30, 50
FOREST_THRESHOLD=30
FOREST_THRESHOLDS=10,30,50
# DuckDB warehouse path
WAREHOUSE_PATH=data/warehouse.duckdb
# Web origin allowed by the API (CORS)
WEB_ORIGIN=http://localhost:5173
